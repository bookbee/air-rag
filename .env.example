# air-rag — every configuration key, with its default.
#
# Copy to `.env` (git-ignored) and edit. `make env` does the copy for you. Every
# key is read by pydantic-settings from the environment with the prefix
# AIR_RAG__ and `__` as the nesting delimiter.

# ── Application ───────────────────────────────────────────────────────────────

AIR_RAG__APP__ENV=development
AIR_RAG__APP__HOST=0.0.0.0
# 8087 is this service's slot in the AIR port map (air-infra/README.md). 8080 is
# air-infra, 8081 air-platform, 8082 air-classifier, 8083 air-model-gateway, 8084 air-tools, 8085 air-action, 8086 air-recommender.
AIR_RAG__APP__PORT=8087
AIR_RAG__APP__DOCS_ENABLED=true
AIR_RAG__APP__MAX_BODY_BYTES=1048576

# ── air-model-gateway (required) ──────────────────────────────────────────────
#
# Embeddings (ingestion and query-time) go through this client
# (clients/model_gateway.py, POST /v1/embed) — never a provider SDK, never a
# provider key held here. /v1/ready gates on this and on nothing else.
#
# API_KEY is this service's gateway token: `air-rag-dev` on a laptop (the
# gateway's own .env.example), deploy/local/integration/tokens.env for its
# integration stack on :9083, Secret Manager's air-rag-model-gateway-token on GKE.

AIR_RAG__MODEL_GATEWAY__BASE_URL=http://localhost:8083
AIR_RAG__MODEL_GATEWAY__API_KEY=air-rag-dev
AIR_RAG__MODEL_GATEWAY__TIMEOUT_S=30.0
AIR_RAG__MODEL_GATEWAY__HEALTH_TIMEOUT_S=2.0
AIR_RAG__MODEL_GATEWAY__MAX_RETRIES=2
# The index's identity: a published embedding name. Changing it is a re-index.
AIR_RAG__MODEL_GATEWAY__EMBED_MODEL=local-768-v1
AIR_RAG__MODEL_GATEWAY__EMBED_DIMENSIONS=768
# Texts per /v1/embed call (the gateway rejects more than 2048).
AIR_RAG__MODEL_GATEWAY__EMBED_BATCH_SIZE=256

# ── Retrieval ─────────────────────────────────────────────────────────────────
#
# Phase 0 ships an in-process vector store (retrieval/memory.py) — correct for
# a laptop and for tests, gone on restart. A real backend is Phase 1.

AIR_RAG__RETRIEVAL__DEFAULT_TOP_K=5

# ── Ingestion ─────────────────────────────────────────────────────────────────
#
# Startup seeding: every *.md / *.txt in SEED_DIR is ingested at boot (front
# matter -> chunk metadata). The SIT corpus is sit/corpus (`make run-sit`).

#AIR_RAG__INGESTION__SEED_DIR=sit/corpus
AIR_RAG__INGESTION__CHUNK_SIZE=800

# ── Security ──────────────────────────────────────────────────────────────────
#
#   python -c "from air_rag.security.api_keys import generate_key; \
#              print(generate_key('your-salt'))"
#
# Every key record needs a `tenant` (lowercase slug): retrieval searches only
# that tenant's documents, and a record without one fails startup.

AIR_RAG__SECURITY__API_KEYS_INLINE=[{"id":"local-dev","name":"Local development key","key_hash":"793c2ca4f19409e8a6e26791b2a933d9ee89caa71449eb157691f8735454b082","tenant":"brightcart","scopes":["retrieval:read","admin:read"]}]
#AIR_RAG__SECURITY__API_KEYS_FILE=/etc/air-rag/keys.json
AIR_RAG__SECURITY__ALLOW_UNAUTHENTICATED=false
# Required when ALLOW_UNAUTHENTICATED=true: the one tenant anonymous callers search.
#AIR_RAG__SECURITY__ANONYMOUS_TENANT=
# [SECRET] Override in every real deployment.
AIR_RAG__SECURITY__HASH_SALT=air-rag-dev-salt
AIR_RAG__SECURITY__DEFAULT_RATE_LIMIT_RPM=120
AIR_RAG__SECURITY__DEFAULT_BURST=20

# ── Observability ─────────────────────────────────────────────────────────────

AIR_RAG__OBS__SERVICE_NAME=air-rag
AIR_RAG__OBS__LOG_LEVEL=INFO
AIR_RAG__OBS__LOG_FORMAT=json
AIR_RAG__OBS__METRICS_ENABLED=true
AIR_RAG__OBS__METRICS_PATH=/metrics
